generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  MANUAL_ADVANCE
  COD
}
enum PaymentStatus {
  UNPAID
  ADVANCE_PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}
model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  products Product[]
  createdAt DateTime @default(now())
}
model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @db.Text
  active Boolean @default(true)
  available Boolean @default(true)
  basePrice Decimal @db.Decimal(10,2)
  categoryId String
  category Category @relation(fields:[categoryId], references:[id])
  images ProductImage[]
  options ProductOption[]
  orderItems OrderItem[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId,active])
}
model ProductImage {
  id String @id @default(cuid())
  url String
  alt String?
  sortOrder Int @default(0)
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
}
model ProductOption {
  id String @id @default(cuid())
  kind String
  name String
  priceDelta Decimal @default(0) @db.Decimal(10,2)
  active Boolean @default(true)
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@unique([productId,kind,name])
}
model Customer {
  id String @id @default(cuid())
  name String
  email String
  phone String
  orders Order[]
  reviews Review[]
  createdAt DateTime @default(now())
  @@index([email])
}
model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  status OrderStatus @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal Decimal @db.Decimal(10,2)
  deliveryFee Decimal @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)
  deliveryDate DateTime
  deliveryAddress String @db.Text
  deliveryAreaId String
  deliveryArea DeliveryArea @relation(fields:[deliveryAreaId],references:[id])
  deliverySlotId String
  deliverySlot DeliverySlot @relation(fields:[deliverySlotId],references:[id])
  customerId String
  customer Customer @relation(fields:[customerId],references:[id])
  items OrderItem[]
  history OrderStatusHistory[]
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,deliveryDate])
}
model OrderItem {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id])
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  nameSnapshot String
  quantity Int
  unitPrice Decimal @db.Decimal(10,2)
  selectedOptions Json?
  customisation String? @db.Text
}
model DeliveryArea {
  id String @id @default(cuid())
  name String @unique
  fee Decimal @db.Decimal(10,2)
  active Boolean @default(true)
  orders Order[]
}
model DeliverySlot {
  id String @id @default(cuid())
  label String
  startTime String
  endTime String
  active Boolean @default(true)
  orders Order[]
  @@unique([startTime,endTime])
}
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  fromStatus OrderStatus?
  toStatus OrderStatus
  note String?
  adminId String?
  createdAt DateTime @default(now())
  @@index([orderId,createdAt])
}
model Review {
  id String @id @default(cuid())
  rating Int
  comment String? @db.Text
  approved Boolean @default(false)
  customerId String
  customer Customer @relation(fields:[customerId],references:[id])
  productId String
  product Product @relation(fields:[productId],references:[id])
  createdAt DateTime @default(now())
}
