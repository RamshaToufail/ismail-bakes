# Neon pooled connection string for application runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
# Neon direct connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
# Owner-approved nearby Rawalpindi service areas, comma-separated. Leave empty until confirmed.
NEXT_PUBLIC_RAWALPINDI_SERVICE_AREAS=""
